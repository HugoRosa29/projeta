# Banco (PostgreSQL). Em dev: docker run -d --name projeta-pg -e POSTGRES_USER=projeta -e POSTGRES_PASSWORD=projeta -e POSTGRES_DB=projeta -p 55432:5432 postgres:17-alpine
DATABASE_URL=postgresql://projeta:projeta@127.0.0.1:55432/projeta

# Sessão (cookie HttpOnly). Em produção: COOKIE_SECURE=true (HTTPS)
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# Login pelo GIA (único meio de entrar). Mesmo serviço e código de sistema do portal-terracap.
GIA_SERVICE=http://gia-api
GIA_ENDPOINT=/auth/autenticar
GIA_SYSTEM_ID=653
GIA_TIMEOUT_S=15
GIA_VERIFY_SSL=true
# Domínio do e-mail de reserva (matrícula@domínio) quando o GIA não devolve e-mail
GIA_EMAIL_DOMAIN=gia.local

# Assistente (somente servidor). provider: openai | mock (mock = respostas determinísticas, só dev/testes)
ASSISTANT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Latência: esforço de raciocínio (none|minimal|low|medium|high; none só a partir da gpt-5.1)
# e tamanho da resposta (low|medium|high).
OPENAI_REASONING_EFFORT=low
OPENAI_TEXT_VERBOSITY=low
ASSISTANT_MAX_TOOL_ROUNDS=8
ASSISTANT_MAX_INPUT_CHARS=2000
ASSISTANT_RATE_LIMIT_PER_HOUR=60
ASSISTANT_PROPOSAL_TTL_MIN=30
# Critério de "projeto parado" (dias sem atividade)
INACTIVITY_DAYS=7
